# Copy to .env (git-ignored) or set these in your IDE run configuration / shell.
# The application does NOT load .env files by itself; export them or configure your IDE.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/synapsemcp
# Application role (non-owner, so RLS applies). See docs/local-db-setup.sql
DB_USERNAME=synapse_app
DB_PASSWORD=change-me
# Flyway role (schema owner / superuser). Defaults to DB_USERNAME if unset, which will NOT work for migrations.
DB_MIGRATION_USERNAME=admin
DB_MIGRATION_PASSWORD=change-me

# --- Auth ---
# Base64-encoded secret, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# --- Google Gemini (chat model gemini-3.5-flash, embeddings gemini-embedding-2 @ 768 dims) ---
GEMINI_API_KEY=

# --- AWS S3 (transient staging only) ---
S3_BUCKET=aws-rag-bucket-app
AWS_REGION=us-east-1
# Read explicitly by the app (the AWS default provider chain / AWS_ACCESS_KEY_ID are NOT used)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# Leave blank for real AWS. Set only for LocalStack/MinIO, e.g. http://localhost:4566
S3_ENDPOINT=

# --- Optional ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
